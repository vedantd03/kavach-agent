# kavach-agent, Phase 1A. Copy to .env and edit. NEVER commit .env.
SERVER_URL=http://localhost:8000
DEVICE_ID=LAPTOP-01
DEVICE_TOKEN=dev-token-1
AGENT_VERSION=0.1.0
AGENT_DB=agent.db

# 2 for the demo, 10 in normal operation
POLL_INTERVAL_SEC=10
PROGRESS_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=30
PROCESSOR_THREADS=2

# crawl defaults (a server SCAN command overrides these per scan)
MAX_FILE_MB=50
# INCLUDE_TYPES=txt,md,log,json,env,ini,yaml,yml,xml,eml,csv,tsv,xlsx,docx,pdf,png,jpg,jpeg,tiff
# EXCLUDE_DIRS=.git,node_modules,.venv,venv,__pycache__,.cache,Library,AppData,.Trash,.pii_vault

# HTTP behaviour (api.md 1)
RETRY_ATTEMPTS=5
RETRY_BACKOFF_SEC=1,2,4,8,16
TIMEOUT_POLL_SEC=15
TIMEOUT_OCR_SEC=60
TIMEOUT_DETECT_SEC=180
TIMEOUT_DEFAULT_SEC=15

# set to 0 if the server rejects local-* scan ids on /detect
SEND_LOCAL_SCAN_ID=1
LOG_LEVEL=INFO

# 1B / Phase 2 (unused in 1A)
ORG_SALT=change-me
FERNET_KEY=
LOCAL_MODEL=
LOCAL_OCR=
